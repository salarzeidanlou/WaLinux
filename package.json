{
  "name": "walinux",
  "private": true,
  "version": "0.1.2",
  "description": "An unofficial, lightweight WhatsApp Web desktop client for Linux, built with Tauri and Rust.",
  "author": "Sullivan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salarzeidanlou/WaLinux.git"
  },
  "homepage": "https://github.com/salarzeidanlou/WaLinux#readme",
  "bugs": {
    "url": "https://github.com/salarzeidanlou/WaLinux/issues"
  },
  "keywords": [
    "linux",
    "tauri",
    "rust",
    "whatsapp-web",
    "desktop-app"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@11.6.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "npm run build",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.1"
  }
}
